(* Синтаксическая грамматика. Пробелы между токенами пропускает лексер.
   Регистр ключевых слов не учитывается. Каждый запрос занимает одну строку.
   Имена правил в дереве отображаются с пробелами: УсловиеНот → Условие нот. *)

Запрос = Команда, ["все"], [Семейство], Объект,
         [Бренд], [УсловиеНот], [Сезон], [Цена] ;

Команда = "найди" | "покажи" | "выведи" ;
Семейство = "древесные" | "цветочные" | "цитрусовые" | "восточные" | "свежие" ;
Объект = "ароматы" ;

Бренд = "бренда", НазваниеБренда ;
НазваниеБренда = STRING ;

УсловиеНот = "с", ("нотой", Нота | "нотами", СписокНот)
           | "без", ПереченьНот ;
СписокНот = Нота, "и", Нота, {"и", Нота} ;
ПереченьНот = Нота, {"и", Нота} ;
Нота = "бергамота" | "кедра" | "ванили" | "розы"
     | "жасмина" | "мускуса" | "ветивера" | "сандала" ;

Сезон = "для", НазваниеСезона ;
НазваниеСезона = "зимы" | "весны" | "лета" | "осени" ;

Цена = ("дешевле" | "дороже"), Число, "рублей"
     | "от", Число, "до", Число, "рублей" ;
Число = NUMBER ;

(* Лексические классы:
   NUMBER — одна или несколько цифр ASCII 0–9, без знака и дробной части.
   STRING — двойная кавычка U+0022, непустой текст, двойная кавычка U+0022.
            Текст не содержит кавычек и перевода строки; одни пробелы запрещены.
            Экранирование кавычек не поддерживается.
   WORD   — русские/латинские буквы; допускается дефис между группами букв.
            Неизвестное слово передаётся парсеру и вызывает синтаксическую ошибку.
   Токены разделяются одним или несколькими пробельными символами.
   Полный разбор требует конца входа: оставшиеся токены являются ошибкой. *)
